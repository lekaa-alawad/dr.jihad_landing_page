# Cloudflare Pages response headers.
#
# /assets/* is content-hashed by Vite, so it can be cached forever. /fonts and
# /img are served under fixed names straight from public/, so they get a long
# but revalidatable life instead — the case photography is expected to change
# when the client supplies real work, and a year of immutable would strand it.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
